<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Silver Meridian — Digital Experience Architects</title>

    <style>
      body {
        margin: 0;
        padding: 0;
        background: #020716;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        color: rgba(255,255,255,0.9);
        text-align: center;
      }

      img {
        width: 100%;
        height: auto;
        display: block;
      }

      /* Legal buttons under banner */
      .legal-links {
        margin: 24px 0 10px;
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
      }

      .legal-btn {
        display: inline-block;
        padding: 10px 16px;
        border-radius: 999px;
        text-decoration: none;
        border: 1px solid rgba(255,255,255,0.18);
        background: rgba(255,255,255,0.06);
        color: rgba(255,255,255,0.92);
        font-size: 14px;
        transition: background 0.2s ease;
      }

      .legal-btn:hover {
        background: rgba(255,255,255,0.12);
      }

      footer {
        margin-top: 40px;
        padding: 20px 12px;
        border-top: 1px solid rgba(255,255,255,0.12);
        font-size: 13px;
        color: rgba(255,255,255,0.65);
      }

      footer a {
        color: rgba(255,255,255,0.8);
        text-decoration: none;
      }

      footer a:hover {
        text-decoration: underline;
      }
    </style>
  </head>

  <body>

    <!-- HERO IMAGE -->
    <img 
      src="images/Silver-Meridian-Site-Banner2.png"
      alt="Silver Meridian — Digital Experience Architects"
    />

    <!-- LEGAL LINKS -->
    <div class="legal-links">
      <a class="legal-btn" href="terms.html">Terms &amp; Conditions</a>
      <a class="legal-btn" href="privacy.html">Privacy Policy</a>
    </div>

    <!-- FOOTER -->
    <footer>
      <div>
        <a href="terms.html">Terms</a>
        &nbsp;•&nbsp;
        <a href="privacy.html">Privacy</a>
      </div>
      <div style="margin-top:8px;">
        © <span id="year"></span> Silver Meridian
      </div>
    </footer>

    <script>
      document.getElementById("year").textContent = new Date().getFullYear();
    </script>

  </body>
</html>

